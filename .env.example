# ============================================================
# 智慧问诊 Agent 系统 - 环境变量模板
# 复制为 .env 并填写真实密钥：cp .env.example .env
# ============================================================

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
ENV=dev

# MySQL配置（本机 3306 若被占用，容器映射到 3307）
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=medical_consult

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=86400

# Neo4j图谱配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=123456

# 大模型配置（P4-3 微调完成后，改 LLM_BASE_URL/LLM_MODEL 一行切换本地/云端）
LLM_API_KEY=你的模型密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 向量模型配置（首次运行自动下载 BAAI/bge-m3，约 2.2GB，需联网）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 1=只用本地已下载的模型（本机开发默认，没下载会直接报错而不是卡在联网校验）
# 0=允许下载（容器首次启动需要，之后缓存进 hf-cache 卷复用）
EMBEDDING_LOCAL_ONLY=1

# 项目根目录：仅容器里需要显式指定（镜像内层级不同，按文件层级会算成 /）
# docker-compose.yml 已自动设为 /app，本机开发不要设这一项。
# PROJECT_ROOT=/app

# ============================================================
# 检索与生成预算（可调阈值 —— 不该硬编码在代码里）
# ============================================================
# 证据预算：条数 + 字符双上限。留空即用默认值。
# 依据：trace 实测一次问诊曾灌进 45 条证据，token 成本与延迟随之膨胀。
# 注意别调太小：单个实体的画像（如「布洛芬」16 条关系）被截断会丢掉关键事实。
EVIDENCE_MAX_ITEMS=20
EVIDENCE_MAX_CHARS=2400
# 相关性下限：低于此分数的命中视为噪声（不当症状标签/科室依据）
RELEVANCE_FLOOR=0.6
# 词面命中加成：查询里直接出现实体名时给相似度加权
LEXICAL_BOOST=0.15
# 同族去重阈值（字符级 Jaccard）
FAMILY_JACCARD=0.7
# 单次工具调用返回条数
TOOL_TOP_K=5

# ============================================================
# 超时与熔断（依赖外部服务必须假设它会挂）
# ============================================================
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
# 连续失败几次触发熔断；熔断后冷却多少秒再半开试探
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN=60
# 图数据库查询超时（秒）
DB_TIMEOUT=10

# ============================================================
# 日志（结构化 JSON，trace_id 自动贯穿）
# ============================================================
LOG_LEVEL=INFO
# 1=JSON（生产/采集用）；0=人类可读（本地调试用）
LOG_JSON=1

# ============================================================
# 安全（对外提供服务前必须设置！）
# ============================================================
# 管理类接口（/api/eval、/api/kg、/api/trace）的访问令牌，请求头 X-Admin-Token。
# 留空 = 只允许本机访问（本地开发默认，零配置可用）。
# 注意：一旦让别人访问（局域网/公网），必须设置，否则管理接口被锁死在本机、
#      或者你为了图方便设成弱口令 —— 那样评估接口会被人拿来烧你的 token。
ADMIN_TOKEN=
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
