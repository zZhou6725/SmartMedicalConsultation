# ============================================================
# 智慧问诊 Agent 系统 - 环境变量模板
# 复制为 .env 并填写真实密钥：cp .env.example .env
# ============================================================

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
ENV=dev

# MySQL配置（本机 3306 若被占用，容器映射到 3307）
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=medical_consult

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=86400

# Neo4j图谱配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=123456

# 大模型配置（P4-3 微调完成后，改 LLM_BASE_URL/LLM_MODEL 一行切换本地/云端）
LLM_API_KEY=你的模型密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 向量模型配置（首次运行自动下载 BAAI/bge-m3，约 2.2GB，需联网）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
