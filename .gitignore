# 环境变量（含密钥，禁止提交）
.env

# 虚拟环境
venv/
venv312/
.venv/

# Python
__pycache__/
*.pyc

# Node
node_modules/

# IDE
.idea/
.vscode/

# 本地产物
data/raw/

# 向量索引产物（可重建：python knowledge/index/build_vector_index.py）
knowledge/index/*.index
knowledge/index/*.json

# 评测报告产物（可重建：cd backend && python -m app.eval）
eval/reports/

# 接口测试产生的临时文件
resp.json
resp*.json
payload.json
payload*.json

# 工具链产生的临时工作目录（沙箱/安装器）
tmp*/
pip-*/
_wheels*/
# PyTorch 编译缓存（正常落在 TEMP；沙箱改写 TEMP 后会落到工作区）
torchinductor_*/
# 验收/校验用的临时脚本与结果（统一下划线前缀）
_*.py
_*.cjs
_*.json
_*.log

# 内部文档与脚本（不随仓库公开）
docs/
scripts/
